  "diff": "--- local71/workspace.css\n+++ current/frontend/src/workspace.css\n@@ -396,6 +396,10 @@\n .patient-form .lede { font-size: 14px; color: var(--muted); line-height: 1.7; }\n .self-report-form .field { font-size: var(--text-label); }\n .adherence-report:focus { outline: 2px solid var(--signal-dark); outline-offset: 4px; }\n+.adherence-report { border-color: var(--line); }\n+.adherence-report h3 { font-size: 16px; line-height: 1.45; }\n+.adherence-report p,.adherence-report blockquote { font-size: var(--text-body); line-height: 1.65; color: var(--ink); }\n+.adherence-report > .badge { font-size: var(--text-caption); }\n .survey-form-meta { display: flex; gap: 14px; align-items: center; justify-content: space-between; flex-wrap: wrap; font-size: 12px; color: var(--muted); }\n .draft-disclosure { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px; margin: 24px 0; background: #edf5f2; border-radius: 9px; font-size: 13px; line-height: 1.6; color: #49685e; }\n .draft-disclosure > svg { flex-shrink: 0; margin-top: 2px; }\n",
