  "diff": "--- local47/App.tsx\n+++ current/frontend/src/App.tsx\n@@ -1,4 +1,4 @@\n-import { Fragment, lazy, Suspense, useCallback, useEffect, useId, useLayoutEffect, useRef, useState, type FormEvent } from \"react\";\n+import { Fragment, lazy, Suspense, useCallback, useEffect, useId, useLayoutEffect, useRef, useState, type CSSProperties, type FormEvent } from \"react\";\n import {\n   Activity,\n   LayoutDashboard,\n@@ -34,7 +34,7 @@\n import { DoctorInbox, DoctorInboxNotice } from \"./DoctorInbox\";\n import { RoleGuide } from \"./RoleGuide\";\n import { NavigationGuard, useNavigationGuard } from \"./NavigationGuard\";\n-import { AnimatePresence, ContentFrame, m, motionTokens, useInteractionMotion, usePendingSelectFocus } from \"./Interaction\";\n+import { AnimatePresence, m, motionTokens, useInteractionMotion, usePendingSelectFocus } from \"./Interaction\";\n import { SectionBoundary } from \"./SectionBoundary\";\n import { ViewStateProvider, type PatientAnswerTarget, type ReturnPoint } from \"./ViewState\";\n import { cardSections, defaultView, navigationFor, sectionFor, type NavItem, type CardTab } from \"./navigation\";\n@@ -549,7 +549,11 @@\n             </m.div>\n           )}</AnimatePresence>\n           <RoleGuide key={user.id} user={user} view={view} navigate={navigate} startSignal={guideStart}/>\n-          <AnimatePresence mode=\"wait\" initial={false}><ContentFrame key={`${view}-${navigationRevision}`}>\n+          <div key={`${view}-${navigationRevision}`} className=\"content-frame route-frame\" style={{\n+            \"--route-duration\":`${transition.duration}s`,\n+            \"--route-distance\":`${moving?motionTokens.distance.small:0}px`,\n+            \"--route-ease\":`cubic-bezier(${motionTokens.easing.smooth.join(\",\")})`,\n+          } as CSSProperties}>\n           <div className=\"route-page\" data-page-location={routeHref(locationSnapshot.current?.route??pageRoute(user.role,view))}>\n           <SectionBoundary key={`${user.id}-${view}`} refresh={()=>guard.run(()=>window.location.reload())}>\n           <Suspense fallback={<div className=\"route-loading\"><Loading/></div>}>\n@@ -591,7 +595,7 @@\n           </Suspense>\n           </SectionBoundary>\n           </div>\n-          </ContentFrame></AnimatePresence>\n+          </div>\n         </main>\n         <footer className=\"app-footer\">\n           Clinical Compass · учебный MVP{\" \"}\n--- local47/workspace.css\n+++ current/frontend/src/workspace.css\n@@ -68,6 +68,12 @@\n .search-field:focus-within { outline: 3px solid var(--signal-dark); outline-offset: 2px; }\n .search-field input:focus-visible { outline: none; }\n .content-frame { min-width: 0; }\n+.route-frame { animation:route-enter var(--route-duration) var(--route-ease) backwards; }\n+@keyframes route-enter {\n+  from { opacity:0; transform:translateY(var(--route-distance)); }\n+  to { opacity:1; transform:none; }\n+}\n+@media (prefers-reduced-motion:reduce) { .route-frame { animation:none; } }\n .main-content { scroll-margin-top: 80px; }\n .route-loading { min-height: 340px; }\n .content-frame > :last-child { margin-bottom: 0; }\n",
