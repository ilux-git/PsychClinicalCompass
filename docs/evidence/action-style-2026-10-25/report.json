  "diff": "--- local48/brand-theme.css\n+++ current/frontend/src/brand-theme.css\n@@ -5,7 +5,7 @@\n .button.primary:hover:not(:disabled) { background:#333536; border-color:#333536; }\n .button.secondary { color:var(--ink); border-color:var(--line); }\n .button.secondary:hover:not(:disabled) { background:var(--paper); border-color:var(--muted); }\n-.button.ghost,.back-link,.skip-link { color:var(--signal-dark); }\n+.button.ghost,.back-link,.skip-link,.text-link,.disclosure-trigger { color:var(--signal-dark); }\n .button.ghost:hover:not(:disabled) { background:var(--signal-soft); }\n button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible { outline-color:var(--signal-dark); }\n input:not([type=\"checkbox\"],[type=\"radio\"]),select,textarea { border-color:#858681; color:var(--ink); background:var(--surface); }\n--- local48/styles.css\n+++ current/frontend/src/styles.css\n@@ -695,7 +695,7 @@\n .period-toolbar > .text-link {\n   margin-left: 4px;\n   font-size: var(--text-label, 13px);\n-  min-height: 40px;\n+  min-height: 44px;\n }\n .metric-grid {\n   display: grid;\n--- local48/workspace.css\n+++ current/frontend/src/workspace.css\n@@ -82,6 +82,7 @@\n .disclosure-grid { display: grid; margin-inline: -3px; }\n .disclosure-reveal { overflow: hidden; min-height: 0; }\n .disclosure-content { padding: var(--space-2) 3px 0; }\n+.panel > .field-hint + .disclosure { margin-top:var(--space-3); }\n details > summary { min-height: 40px; padding-block: 10px; }\n .disclosure-reveal .field { margin-top: var(--space-4); }\n .board-card .section-heading { gap: 8px; }\n@@ -194,7 +195,7 @@\n .toast { position: fixed; top: auto; right: 26px; bottom: 24px; z-index: 60; width: max-content; max-width: min(520px,calc(100vw - 32px)); margin: 0; box-shadow: 0 8px 30px #1b354326; border-radius: 12px; background: #fff; }\n .toast.success { border-color: #a9cfc1; color: #245d4c; }\n .avatar { color: #316b68; background: #e6f0ef; }\n-.back-link { min-height: 40px; font-size: 13px; margin-bottom: 12px; color: #32736f; }\n+.back-link { min-height: 44px; font-size: 13px; margin-bottom: 12px; color: #32736f; }\n .patient-heading { padding-bottom: 20px; margin-bottom: 8px; }\n .patient-heading h1 { font-size: 28px; }\n .patient-heading .avatar { width: 56px; height: 56px; font-size: 20px; border-radius: 14px; }\n",
