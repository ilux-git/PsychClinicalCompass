{
  "name": "clinical-compass-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:clean": "tsc --noEmit && vite build --emptyOutDir",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:patient-progress": "node --test tests/patient-progress.test.mjs",
    "test:care-progress": "node --test tests/care-progress.test.mjs",
    "test:clinic-summary": "node --test tests/clinic-summary.test.mjs",
    "test:participation-views": "node --test tests/participation-views.test.mjs",
    "test:doctor-note": "node --test tests/doctor-note-interaction.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
